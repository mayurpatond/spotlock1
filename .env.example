# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# DATABASE_URL: PostgreSQL database connection string for SpotLock in production.
# Simply paste your Postgres connection URI here (e.g., Supabase, Neon, AWS RDS, Render, or local Postgres).
# Format: postgres://<user>:<password>@<host>:<port>/<database_name>?sslmode=require
DATABASE_URL="postgres://postgres:password@localhost:5432/spotlock"

# Optional Cloud SQL direct parameters if not using a single connection string:
# SQL_HOST="localhost"
# SQL_DB_NAME="spotlock"
# SQL_USER="postgres"
# SQL_PASSWORD="yourpassword"
